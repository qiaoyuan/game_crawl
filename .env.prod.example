# 生产环境配置模板
# 用法：复制为 .env.prod 并填入真实值，再用 APP_ENV=prod 运行
#   cp .env.prod.example .env.prod
# 注意：APP_ENV 必须作为系统环境变量导出（export APP_ENV=prod），不能写在本文件里

# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=game_platform
DB_PASSWORD=your_db_password
DB_NAME=game_platform

# ---------- 浏览器引擎 ----------
# 用 Playwright 自带 Chromium：置空（推荐，服务器不用装 Google Chrome）
# 用系统真实 Chrome（反检测更强，需先装 google-chrome）：填 chrome
BROWSER_CHANNEL=

# 服务器无显示器，必须开启无头模式
BROWSER_HEADLESS=1
