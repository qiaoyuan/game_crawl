# 环境配置模板
# 本地开发:  cp .env.example .env     （读 .env）
# 生产部署:  cp .env.example .env.prod （读 .env.prod，并设 APP_ENV=prod）
#
# .env / .env.prod 已被 .gitignore 排除，不会提交到 git，
# 密码等敏感信息只放这两个文件里。

# 运行环境: local=本地开发 / prod=生产
APP_ENV=local

# ===== 数据库 =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=game_platform

# 爬虫服务器编号：只领取 crawl_target.crawl_server 相同的任务
crawl_server=1

# G2G 每个目标最多抓取前 10 条竞品（默认与加强类型均适用）
CRAWL_OFFER_LIMIT=10

# ELD 每个目标只抓第一页，最多 8 条；API 与 DOM 兜底均适用
ELD_OFFER_PAGE_SIZE=8
