# 环境配置模板
# 本地开发:  cp .env.example .env     （读 .env）
# 生产部署:  cp .env.example .env.prod （读 .env.prod，并设 APP_ENV=prod）
#
# .env / .env.prod 已被 .gitignore 排除，不会提交到 git，
# 密码等敏感信息只放这两个文件里。

# 运行环境: local=本地开发 / prod=生产
APP_ENV=local

# ===== 数据库 =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=game_platform

# 爬虫服务器编号：只领取 crawl_target.crawl_server 相同的任务
crawl_server=1

# 生产启动脚本：worker 独立调度窗口（秒），到期完成当前任务后重启；0 回退单轮
CRAWL_WORKER_RUN_SECONDS=300

# G2G 游戏币仅取第一页 20 条，排除自家店铺后最多保存 min(配置值, 10) 条；其他分类取前 N 条。
CRAWL_OFFER_LIMIT=10

# ELD 保存上限：API 固定请求 150 条，先排除配置店铺，再按 USD 单价升序取前 8 条
ELD_OFFER_PAGE_SIZE=8

# 全局排除店铺（G2G/ELD）：多个名字用逗号分隔，跳过加强、分析和入库
CRAWL_EXCLUDE_STORES=Vivi_Store

# 本机请求 UA（空值沿用平台默认值；填写与实际浏览器匹配的 UA）
CRAWL_USER_AGENT=
# 浏览器页面尺寸；API 请求不受尺寸影响
CRAWL_VIEWPORT_WIDTH=1280
CRAWL_VIEWPORT_HEIGHT=800

# 独立服务监控：直接使用上方 DB_*，编号根据 crawl_server 自动生成
SERVER_MONITOR_INTERVAL=10
SERVER_MONITOR_DISK_PATH=/
